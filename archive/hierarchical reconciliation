def _compute_model_metrics(y_rec_df, y_test_df, value_cols):
    if y_test_df.empty:
        return pd.DataFrame({
            'model': value_cols,
            'n_points': [0] * len(value_cols),
            'mae': [np.nan] * len(value_cols),
            'mape_pct': [np.nan] * len(value_cols),
        })

    merged_df = y_rec_df.merge(y_test_df, on=['unique_id', 'ds'], how='left')
    metric_rows = []
    for value_col in value_cols:
        valid_df = merged_df[['y', value_col]].dropna()
        if valid_df.empty:
            metric_rows.append({
                'model': value_col,
                'n_points': 0,
                'mae': np.nan,
                'mape_pct': np.nan,
            })
            continue

        errors = valid_df[value_col].to_numpy(dtype=float) - valid_df['y'].to_numpy(dtype=float)
        denominators = np.where(
            np.abs(valid_df['y'].to_numpy(dtype=float)) > 1e-9,
            np.abs(valid_df['y'].to_numpy(dtype=float)),
            np.nan,
        )
        ape_pct = np.abs(errors) / denominators * 100.0
        metric_rows.append({
            'model': value_col,
            'n_points': int(len(valid_df)),
            'mae': float(np.mean(np.abs(errors))),
            'mape_pct': float(np.nanmean(ape_pct)) if np.isfinite(ape_pct).any() else np.nan,
        })

    return pd.DataFrame(metric_rows)

